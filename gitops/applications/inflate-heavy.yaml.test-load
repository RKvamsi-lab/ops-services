apiVersion: apps/v1
kind: Deployment
metadata:
  name: inflate-heavy

spec:
  replicas: 20

  selector:
    matchLabels:
      app: inflate-heavy

  template:
    metadata:
      labels:
        app: inflate-heavy

    spec:
      containers:
      - name: inflate

        image: public.ecr.aws/eks-distro/kubernetes/pause:3.7

        resources:
          requests:
            cpu: "1000m"
            memory: "512Mi"